# Copy this file to .env and fill in your Supabase values
# Settings → Database → Connection string (URI format)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# Settings → API → service_role key (long eyJ... token)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Pick any long random string — used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-secret

# Port the GraphQL server listens on
PORT=4000
